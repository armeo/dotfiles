// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "theme": "Everforest Dark Hard (blur)",
  "buffer_font_family": "Iosevka Nerd Font Mono",
  "buffer_font_size": 16,
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 16,
  "icon_theme": "Catppuccin Mocha",
  "base_keymap":"SublimeText",
  "vim_mode": true,
  "buffer_line_height": {"custom": 1.4},
  "buffer_font_features": {"calt": false},
  "buffer_font_weight": 300,
  "toolbar": {"breadcrumbs": false, "quick_actions": false},
  "project_panel": { "entry_spacing":"standard", "dock": "left"},
  "tabs": {"file_icons": true},
  "git": {"git_gutter":"tracked_files", "inline_blame": {"enabled": true}},
  "current_line_highlight": "none",
  "format_on_save": "off",
  "tab_size": 4,
  "hard_tabs": true
}
